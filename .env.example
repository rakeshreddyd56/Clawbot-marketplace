# Clawbot Marketplace — Environment Variables
# Copy to .env and fill in real values. Never commit .env to source control.

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# Session
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED in production. Min 32 random bytes (hex or base64).
SESSION_SECRET=change_me_in_production_min_32_bytes

# ─────────────────────────────────────────────────────────────────────────────
# Header-based Auth (TASK-HARD-007)
# ─────────────────────────────────────────────────────────────────────────────
# Production default: false (disables x-agent-id / x-role header auth entirely)
# Set to true + provide HEADER_AUTH_SECRET to enable HMAC-signed header auth.
HEADER_AUTH_ENABLED=false
# HEADER_AUTH_SECRET=change_me_min_32_bytes

# ─────────────────────────────────────────────────────────────────────────────
# Moltbook Identity
# ─────────────────────────────────────────────────────────────────────────────
# Leave unset to use FakeMoltbookVerifier in dev/test
# MOLTBOOK_API_URL=https://api.moltbook.io
# MOLTBOOK_API_KEY=mbk_live_...
# MOLTBOOK_AUDIENCE=clawbot.marketplace.production

# Freshness windows (minutes). Defaults: trusted=50, expiry=60
# MOLTBOOK_TRUSTED_WINDOW_MIN=50
# MOLTBOOK_EXPIRY_WINDOW_MIN=60

# ─────────────────────────────────────────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────────────────────────────────────────
# Leave unset to use FakeStripeAdapter in dev/test
# STRIPE_API_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────────────────────
# Database / Persistence
# ─────────────────────────────────────────────────────────────────────────────
# Leave unset to use in-memory store (dev/test). Set for production PostgreSQL.
# DATABASE_URL=postgresql://claw:password@localhost:5432/clawbot

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# RATE_LIMIT_REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# Temporal Workflow Engine
# ─────────────────────────────────────────────────────────────────────────────
# Leave unset to use FakeTemporalAdapter
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=marketplace-event
# TEMPORAL_TLS_CERT=/run/secrets/temporal-tls.crt
# TEMPORAL_TLS_KEY=/run/secrets/temporal-tls.key

# ─────────────────────────────────────────────────────────────────────────────
# Moltbook Webhook (TASK-HARD-014)
# ─────────────────────────────────────────────────────────────────────────────
# HMAC secret for verifying Moltbook-Signature header on incoming webhooks.
# MOLTBOOK_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────────────────────
# Kafka (event streaming)
# ─────────────────────────────────────────────────────────────────────────────
# Leave unset for in-memory event bus (dev/test only).
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=clawbot-api
# KAFKA_GROUP_ID=clawbot-marketplace

# ─────────────────────────────────────────────────────────────────────────────
# OpenTelemetry / Observability
# ─────────────────────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=api-gateway-bff
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp

# ─────────────────────────────────────────────────────────────────────────────
# OPA Policy Decision Service
# ─────────────────────────────────────────────────────────────────────────────
# When unset → policy evaluated in-process (embedded). Set for sidecar mode.
# OPA_URL=http://localhost:8181

# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Defaults to http://localhost:3001 when unset.
# REQUIRED in production — must list all frontend origins.
# CORS_ORIGINS=https://app.clawbot.io,https://console.clawbot.io

# ─────────────────────────────────────────────────────────────────────────────
# Web Console (apps/web)
# ─────────────────────────────────────────────────────────────────────────────
# Server-side BFF proxy target. In Docker Compose: http://api:3000
API_BASE_URL=http://localhost:3000
